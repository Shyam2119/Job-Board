// Prisma schema for TalentFlow Job Board
// Database: PostgreSQL via Neon Serverless
// https://www.prisma.io/docs/concepts/components/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────
// Jobs
// ────────────────────────────────────────────────────────────────
model Job {
  id             String        @id @default(cuid())
  title          String
  company        String
  companySlug    String
  logo           String
  location       String
  city           String        @default("")
  salary         String
  salaryMin      Float         @default(0)
  salaryMax      Float         @default(0)
  type           String        // full-time | part-time | contract | internship | freelance
  description    String        @db.Text
  requirements   String[]
  skills         String[]
  postedDate     DateTime      @default(now())
  category       String        // Tech | Design | Marketing | Finance | Healthcare | Remote | Education | E-Commerce
  featured       Boolean       @default(false)
  experience     String        @default("mid") // fresher | junior | mid | senior | lead
  workMode       String        @default("onsite") // onsite | remote | hybrid
  industry       String        @default("IT") // IT | Banking | Healthcare | E-Commerce | Education | Startup | Consulting | Manufacturing
  noticePeriod   String        @default("1-month") // immediate | 15-days | 1-month | 2-months | 3-months
  companyRating  Float         @default(4.0)
  applicantCount Int           @default(0)
  isSeeded       Boolean       @default(false) // marks seed data vs user-posted jobs

  applications   Application[]
  savedBy        SavedJob[]

  @@index([category])
  @@index([companySlug])
  @@index([workMode])
  @@index([featured])
  @@index([postedDate])
}

// ────────────────────────────────────────────────────────────────
// Applications
// ────────────────────────────────────────────────────────────────
model Application {
  id          String   @id @default(cuid())
  jobId       String
  fullName    String
  email       String
  phone       String
  coverLetter String   @db.Text
  resumeFile  String?
  appliedAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([email])
  @@index([appliedAt])
}

// ────────────────────────────────────────────────────────────────
// Saved / Bookmarked Jobs
// ────────────────────────────────────────────────────────────────
model SavedJob {
  id        String   @id @default(cuid())
  jobId     String
  sessionId String   // anonymous browser session ID
  savedAt   DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sessionId])
  @@index([sessionId])
}

// ────────────────────────────────────────────────────────────────
// User Profile (one per anonymous browser session)
// ────────────────────────────────────────────────────────────────
model UserProfile {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  fullName       String   @default("")
  email          String   @default("")
  phone          String   @default("")
  city           String   @default("")
  linkedin       String   @default("")
  portfolio      String   @default("")
  headline       String   @default("")
  about          String   @db.Text @default("")
  skills         Json     @default("[]")      // ProfileSkill[]
  experiences    Json     @default("[]")      // WorkExperience[]
  education      Json     @default("[]")      // Education[]
  certifications Json     @default("[]")      // Certification[]
  preferences    Json     @default("{}")      // JobPreferences
  resumeFileName String   @default("")
  resumeSize     String   @default("")
  resumeUploadedAt String @default("")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([sessionId])
}
