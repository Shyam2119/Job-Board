# ─────────────────────────────────────────────────────────────────
# Site Configuration
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://job-board-jet-delta.vercel.app

# ─────────────────────────────────────────────────────────────────
# Database (Neon PostgreSQL)
# Sign up at https://neon.tech and create a project
# Copy the connection strings from Project Settings → Connection Details
# ─────────────────────────────────────────────────────────────────

# Pooled connection — used by Prisma Client at runtime (serverless-safe)
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"

# Direct connection — used by Prisma Migrate / db push
DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"
